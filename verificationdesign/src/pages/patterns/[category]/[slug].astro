---
import { getCollection, render } from 'astro:content';
import CardLayout from '../../../layouts/CardLayout.astro';
import { READING_ORDER } from '../../../lib/reading-order.mjs';

export async function getStaticPaths() {
  const cards = await getCollection('patterns');
  return cards.map((card) => ({
    params: { category: card.data.category, slug: card.data.slug },
    props: { card },
  }));
}

const { card } = Astro.props;
const allCards = await getCollection('patterns');
const orderIndex = new Map(READING_ORDER.map((id, index) => [id, index]));
const unordered = allCards.filter((c) => !orderIndex.has(c.id));

if (unordered.length > 0) {
  throw new Error(`Missing reading order entries: ${unordered.map((c) => c.id).join(', ')}`);
}

const ordered = [...allCards].sort((a, b) => orderIndex.get(a.id)! - orderIndex.get(b.id)!);
const i = ordered.findIndex((c) => c.id === card.id);
const prev = i > 0 ? ordered[i - 1] : null;
const next = i >= 0 && i < ordered.length - 1 ? ordered[i + 1] : null;

const { Content, headings } = await render(card);
---

<CardLayout
  entry={card}
  headings={headings}
  prev={prev}
  next={next}
  markdownPath={`/patterns/${card.data.category}/${card.data.slug}.md`}
>
  <Content />
</CardLayout>
